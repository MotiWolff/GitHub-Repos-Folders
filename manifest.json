{
  "manifest_version": 3,
  "name": "GitHub Repo Folders",
  "version": "0.1.0",
  "description": "Group GitHub repositories into folders in the UI.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GitHub Repo Folders",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["scripts/ghf-core.js", "scripts/ghf-dom.js", "scripts/ghf-ui.js", "scripts/ghf-grouping.js", "content-script.js"],
      "css": ["content-style.css"],
      "run_at": "document_idle"
    }
  ]
}


